{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "turbo.json",
                "lighthouserc.cjs",
                "knip.json",
                "syncpack.config.mjs",
                "scripts/*.{mjs,js,ts}",
                "bench/scenarios/*.js"
            ],
            "ignoreDependencies": ["k6", "postcss-load-config"]
        },
        "apps/admin": {
            "entry": [
                "app/**/{page,layout,loading,error,not-found,route,template}.{ts,tsx}",
                "app/web-vitals.tsx",
                "env.ts",
                "features/**/index.tsx",
                "lib/data/use-*.ts",
                "test/setup.ts"
            ],
            "project": ["**/*.{ts,tsx}"]
        },
        "apps/client": {
            "entry": [
                "app/**/{page,layout,loading,error,not-found,route,template}.{ts,tsx}",
                "app/web-vitals.tsx",
                "env.ts",
                "features/**/index.tsx"
            ],
            "project": ["**/*.{ts,tsx}"]
        },
        "apps/mobile": {
            "entry": [
                "app/**/{page,layout,loading,error,not-found,route,template}.{ts,tsx}",
                "app/web-vitals.tsx",
                "env.ts",
                "features/**/index.tsx"
            ],
            "project": ["**/*.{ts,tsx}"]
        },
        "packages/ui": {
            "entry": ["src/components/**/*.{ts,tsx}", "src/hooks/*.ts", "src/lib/*.ts"],
            "project": ["src/**/*.{ts,tsx}"]
        },
        "packages/scoring-ui": {
            "entry": ["src/components/**/*.tsx", "src/hooks/*.ts", "src/theme/*.ts"],
            "project": ["src/**/*.{ts,tsx}"]
        },
        "packages/telemetry": {
            "entry": ["src/*.{ts,tsx}"],
            "project": ["src/**/*.{ts,tsx}"]
        },
        "packages/core": {
            "project": ["src/**/*.ts"]
        },
        "packages/types": {
            "project": ["src/**/*.ts"]
        },
        "packages/utils": {
            "project": ["src/**/*.ts"]
        },
        "packages/mock-data": {
            "project": ["src/**/*.ts"]
        },
        "packages/config": {
            "entry": ["tsconfig/*.json"],
            "project": ["**/*.{ts,mjs}"],
            "ignoreDependencies": [
                "prettier-plugin-tailwindcss",
                "stylelint-config-standard",
                "stylelint-config-tailwindcss"
            ]
        }
    }
}
