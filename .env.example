# ──────────────────────────────────────────────────────────────────────────
# LUMIRIS Front — environment template
# Copy to `.env` (and `.env.local` for local-only overrides). Never commit.
# Infra/datastore variables (POSTGRES_*, REDIS_*, MINIO_*) live in
# ../Lumiris-Infra/local/.env — see ../Lumiris-Infra/docs/LOCAL.md.
# ──────────────────────────────────────────────────────────────────────────

# ─── Public-facing URLs (build-time, embedded in JS bundles) ──────────────
NEXT_PUBLIC_WEB_URL=https://lumiris.local
NEXT_PUBLIC_ADMIN_URL=https://admin.lumiris.local
NEXT_PUBLIC_MOBILE_URL=https://mobile.lumiris.local
NEXT_PUBLIC_CLIENT_URL=https://client.lumiris.local

# Public API base — Spring Boot backend, exposed via Traefik on the host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ─── Vercel Analytics & Web Vitals sampling ───────────────────────────────
NEXT_PUBLIC_VERCEL_ANALYTICS=1
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=1.0   # 0.1 in prod

# ─── Lighthouse CI (used by `bun run lhci`) ───────────────────────────────
LHCI_GITHUB_APP_TOKEN=

# ─── Tauri (mobile) — populated when prompt #1 is executed ────────────────
TAURI_PRIVATE_KEY=
TAURI_KEY_PASSWORD=

# ─── Telemetry (OTel + Sentry) ────────────────────────────────────────────
# OTLP/HTTP collector — exposed locally by ../Lumiris-Infra (profile monitoring).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_LOG_LEVEL=info

# One Sentry project per surface — keep DSNs out of git.
SENTRY_DSN_ADMIN=
SENTRY_DSN_CLIENT=
SENTRY_DSN_WEB=
SENTRY_DSN_MOBILE=
