{
    "name": "@lumiris/api-client",
    "version": "0.1.0",
    "private": true,
    "description": "LUMIRIS minimal typed fetch wrapper (auth / telemetry / storage) + TanStack Query helpers (entry React). Sera complété par openapi-typescript quand le backend exposera plus d'endpoints.",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./react": "./src/react.ts"
    },
    "scripts": {
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "typecheck": "tsc --noEmit",
        "clean": "rimraf dist .turbo"
    },
    "dependencies": {
        "@lumiris/types": "workspace:*",
        "@tanstack/react-query-devtools": "^5.62.0",
        "zod": "^4.4.3"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5.62.0",
        "@tanstack/react-query-devtools": "^5.62.0",
        "react": "^19"
    },
    "peerDependenciesMeta": {
        "@tanstack/react-query": {
            "optional": true
        },
        "@tanstack/react-query-devtools": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@tanstack/react-query": "^5.62.0",
        "@types/node": "^22.10.0",
        "@types/react": "^19",
        "eslint": "^9.17.0",
        "react": "^19",
        "rimraf": "^6.0.1",
        "typescript": "^5.7.3"
    }
}
