# Variables communes à toutes les apps Next.js (admin, site, client, mobile).
# Reprises automatiquement par `make env-init` lors de la création de chaque
# apps/<app>/.env. Les overrides spécifiques (NEXT_PUBLIC_APP_NAME, PORT,
# NEXT_PUBLIC_TAURI) vivent dans le .env.example de chaque app.

# Backend Spring Boot (Traefik → host.docker.internal:8080)
NEXT_PUBLIC_API_BASE_URL=https://api.lumiris.local

# Web Vitals : 1.0 en dev, 0.1 en prod
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=1.0

# OTLP collector local (Lumiris-Infra docker compose, profile monitoring)
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Sentry DSN — vide en dev local (init silencieusement skip)
NEXT_PUBLIC_SENTRY_DSN=
