{
    "name": "@lumiris/admin",
    "version": "0.1.0",
    "private": true,
    "description": "LUMIRIS Admin - internal back-office dashboard. Light, clinical, transparent.",
    "scripts": {
        "dev": "next dev --port 3001",
        "build": "next build",
        "start": "next start --port 3001",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "test:cov": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=coverage",
        "clean": "rimraf .next .turbo coverage"
    },
    "dependencies": {
        "@lumiris/api-client": "workspace:*",
        "@lumiris/core": "workspace:*",
        "@lumiris/mock-data": "workspace:*",
        "@lumiris/scoring-ui": "workspace:*",
        "@lumiris/telemetry": "workspace:*",
        "@lumiris/types": "workspace:*",
        "@lumiris/ui": "workspace:*",
        "@lumiris/utils": "workspace:*",
        "@vercel/analytics": "^1.6.1",
        "lucide-react": "^0.564.0",
        "next": "^16.2.4",
        "react": "^19",
        "react-dom": "^19",
        "recharts": "^2.15.4"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^15.11.0",
        "@lumiris/config": "workspace:*",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/bun": "^1.1.14",
        "@types/node": "^22.10.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^10.9.1",
        "postcss": "^8.5",
        "rimraf": "^6.0.1",
        "typescript": "^5.7.3"
    }
}
