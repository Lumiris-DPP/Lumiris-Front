# App-specific overrides for @lumiris/mobile.
# Common vars live in ../.env.example.shared — run `make env-init` from the
# repo root to produce a full apps/mobile/.env (shared + overrides).

NEXT_PUBLIC_APP_NAME=mobile
PORT=3002

# Tauri runtime flag — true uniquement pour un build destiné au shell natif
NEXT_PUBLIC_TAURI=false
